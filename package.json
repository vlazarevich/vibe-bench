{
  "name": "vibe-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm boundaries && pnpm test && pnpm build && pnpm test:browser",
    "local": "pnpm build && node --env-file-if-exists=.env --import tsx scripts/local.ts",
    "demo": "pnpm build && node --env-file-if-exists=.env --import tsx scripts/local.ts --fixture",
    "run:fixture": "node --env-file-if-exists=.env --import tsx apps/runner/src/main.ts fixture",
    "run:live": "node --env-file-if-exists=.env --import tsx apps/runner/src/main.ts live",
    "report:retry": "node --env-file-if-exists=.env --import tsx apps/runner/src/main.ts retry",
    "runtime:onboard": "node --env-file-if-exists=.env --import tsx apps/runner/src/onboard-main.ts",
    "runtime:work": "node --env-file-if-exists=.env --import tsx apps/runner/src/worker-main.ts",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:binary": "node --test tests/runtime-binary.test.mjs && VIBE_RUNTIME_BINARY=\"$PWD/dist/runtime/vibe-runtime\" pnpm exec vitest run tests/configured-loop.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
