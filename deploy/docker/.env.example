# Required. The database password becomes part of a connection URL, so generate one without
# URL or shell punctuation, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret
VIBE_APP_PASSWORD=replace-with-a-long-random-secret

# Public HTTPS with the "https" profile: point DNS for VIBE_DOMAIN at this host first.
# VIBE_PUBLIC_URL defaults to https://VIBE_DOMAIN.
# VIBE_DOMAIN=bench.example.com

# Image and version. Forks publish their own image: ghcr.io/<owner>/<repo>.
# VIBE_IMAGE=ghcr.io/vlazarevich/vibe-bench
# VIBE_VERSION=latest   # the release's own compose.yml defaults to that release

# Direct HTTP listener on the host (default 127.0.0.1:8080). Keep it on loopback when Caddy serves HTTPS.
# VIBE_BIND_ADDRESS=127.0.0.1
# VIBE_HTTP_PORT=8080

# Change both if 172.31.250.0/24 collides with a local network; Caddy's address must be inside the subnet.
# VIBE_DOCKER_SUBNET=172.31.250.0/24
# VIBE_CADDY_ADDRESS=172.31.250.10

# Optional model catalog enrichment.
# ARTIFICIAL_ANALYSIS_API_KEY=
