# Copy to .env for live runs. Both exact IDs are required and must differ.
VIBE_MODEL_A=gpt-6-luna
VIBE_MODEL_B=gpt-6-sol
# Absolute path to the native Codex executable, not codex.cmd or a shell script.
# VIBE_CODEX_BIN=C:/path/to/codex.exe
# VIBE_CODEX_BIN=/path/to/codex
# Optional task text file, read and snapshotted before either model starts.
# VIBE_TASK_FILE=C:/path/to/task.txt
# VIBE_TIMEOUT_MS=180000

# Optional exported saved suite task. Mutually exclusive with VIBE_TASK_FILE.
# VIBE_SUITE_FILE=C:/path/to/suite-task.json
