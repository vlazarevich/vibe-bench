# Copy to .env for live runs. Both exact IDs are required and must differ.
VIBE_MODEL_A=gpt-6-luna
VIBE_MODEL_B=gpt-6-sol
# Absolute path to the native Codex executable, not codex.cmd or a shell script.
# VIBE_CODEX_BIN=/path/to/codex
# Optional task text file, read and snapshotted before either model starts.
# VIBE_TASK_FILE=/path/to/task.txt
# VIBE_TIMEOUT_MS=180000

# Optional exported saved suite task. Mutually exclusive with VIBE_TASK_FILE.
# VIBE_SUITE_FILE=/path/to/suite-task.json

# Outbound runtime onboarding does not read local instance.json.
# Use HTTPS for a remote API, loopback HTTP for local verification.
# VIBE_API_URL=https://bench.example
# VIBE_RUNTIME_SLOTS=1
# VIBE_RUNTIME_STATE=.local/runtime-onboarding
# Optional worker-only listener. Use a trusted reverse proxy with HTTPS remotely.
# VIBE_WORKER_HOST=127.0.0.1
# VIBE_WORKER_PORT=8081
