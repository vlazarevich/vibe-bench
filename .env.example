# Dashboard configuration only. The runner uses CLI pairing and private state.
# VIBE_APP_PASSWORD=replace-with-a-long-random-secret
# VIBE_PUBLIC_URL=https://bench.example
# VIBE_TRUSTED_PROXY=127.0.0.1,::1
# External PostgreSQL 18. When set, no embedded database or VIBE_LOCAL_ROOT state is used.
# POSTGRES_URL is accepted as a fallback name.
# DATABASE_URL=postgresql://user:password@db.example:5432/vibe?sslmode=require
# Embedded PostgreSQL state when DATABASE_URL is unset.
# VIBE_LOCAL_ROOT=/path/to/dashboard-state
# Listener address and port. VIBE_PORT=0 picks a free port.
# VIBE_HOST=127.0.0.1
# VIBE_PORT=8080
# Optional worker-only listener behind the same public HTTPS origin.
# VIBE_WORKER_HOST=127.0.0.1
# VIBE_WORKER_PORT=8081

# Optional server-side model catalog enrichment (Free fallback; Pro provides richer metadata).
# ARTIFICIAL_ANALYSIS_API_KEY=replace-with-your-key
